erDiagram
    RESOURCE ||--o{ PHYSICAL_ITEM : "has copies"
    RESOURCE ||--o| DIGITAL_ITEM : "has digital item"
    RESOURCE ||--o{ BORROW_REQUEST : "requested for"

    ACCOUNTS ||--o{ BORROW_REQUEST : "reader submits"
    ACCOUNTS o|--o{ BORROW_REQUEST : "librarian prepares"
    ACCOUNTS o|--o{ BORROW_REQUEST : "librarian rejects"
    ACCOUNTS o|--o{ BORROW_REQUEST : "librarian fulfils"

    PHYSICAL_ITEM ||--o{ BORROW_REQUEST : "allocated to"

    BORROW_REQUEST ||--o| BORROWING : "creates"
    ACCOUNTS ||--o{ BORROWING : "reader borrows"
    PHYSICAL_ITEM ||--o{ BORROWING : "loan history"

    RESOURCE {
        BIGINT id PK
        VARCHAR title
        VARCHAR authors
        TEXT description
    }

    PHYSICAL_ITEM {
        BIGINT id PK
        BIGINT resource_id FK
        VARCHAR status
    }

    DIGITAL_ITEM {
        BIGINT id PK
        BIGINT resource_id FK, UK
    }

    ACCOUNTS {
        BIGINT id PK
        VARCHAR email UK
        VARCHAR password_hash
        VARCHAR display_name
        VARCHAR role
        VARCHAR account_status
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    BORROW_REQUEST {
        BIGINT id PK
        BIGINT reader_id FK
        BIGINT resource_id FK
        BIGINT physical_item_id FK
        VARCHAR status
        TIMESTAMP requested_at
        TIMESTAMP status_updated_at
        TIMESTAMP expires_at
        TIMESTAMP prepared_at
        BIGINT prepared_by FK
        TIMESTAMP rejected_at
        BIGINT rejected_by FK
        TIMESTAMP fulfilled_at
        BIGINT fulfilled_by FK
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    BORROWING {
        BIGINT id PK
        BIGINT physical_item_id FK
        BIGINT reader_id FK
        BIGINT borrow_request_id FK, UK
        TIMESTAMP borrowed_at
        TIMESTAMP due_at
        TIMESTAMP returned_at
    }