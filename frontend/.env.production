# Same-origin production default. Override at build time when frontend and backend use separate origins.
VITE_API_BASE_URL=/api

# Production bundles must never contain demo adapters.
VITE_USE_MOCK_BORROWINGS=false
VITE_USE_MOCK_LIBRARIAN_BORROWINGS=false
VITE_USE_MOCK_DIGITAL_ACCESS=false
VITE_USE_MOCK_RESOURCE_ADMIN=false
