VITE_API_BASE_URL=http://localhost:8080

# Set to true to preview T-103 without the backend overdue field.
VITE_USE_MOCK_BORROWINGS=false

# Set to true to preview T-114 before the librarian borrowing/return API is available.
VITE_USE_MOCK_LIBRARIAN_BORROWINGS=false

# Set to true to preview T-125 before the protected digital-content API is available.
VITE_USE_MOCK_DIGITAL_ACCESS=false

# Set to true to preview T-135 before the librarian resource API is available.
VITE_USE_MOCK_RESOURCE_ADMIN=false
